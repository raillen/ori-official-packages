module test.nfd

imports
    nfd.dialog as nfd
    ori.test as test
end

@test
set_path_test_hook()
    test.assert(nfd.set_path_for_test("/tmp/foo.bar"), "set")
    test.assert(nfd.is_ok(), "ok")
    test.assert(nfd.path_len() > 0, "len")
    test.equal_int(nfd.path_count(), 1)
end

@test
path_byte_marshalling()
    -- "/tmp/x" bytes: 47 116 109 112 47 120  (len 6)
    test.assert(nfd.set_path_for_test("/tmp/x"), "set")
    test.equal_int(nfd.path_len(), 6)
    test.equal_int(nfd.path_byte(0), 47)
    test.equal_int(nfd.path_byte(1), 116)
    test.equal_int(nfd.path_byte(5), 120)
    test.equal_int(nfd.path_byte(6), 0)
    -- sum of unsigned bytes of "/tmp/x"
    test.equal_int(nfd.path_sum(), 47 + 116 + 109 + 112 + 47 + 120)
end

@test
clear_is_cancel_empty()
    test.assert(nfd.set_path_for_test("/tmp/will_clear"), "set")
    test.assert(nfd.is_ok(), "before clear ok")
    nfd.clear()
    test.assert(not nfd.is_ok(), "after clear not ok")
    test.equal_int(nfd.path_len(), 0)
    test.equal_int(nfd.path_count(), 0)
    test.equal_int(nfd.path_sum(), 0)
end

@test
multi_paths_for_test()
    test.assert(nfd.set_paths_for_test("/a/one.txt;/b/two.txt"), "set multi")
    test.assert(nfd.is_ok(), "ok")
    test.equal_int(nfd.path_count(), 2)
    -- primary path is first
    test.equal_int(nfd.path_len(), 10)
    test.equal_int(nfd.path_byte(0), 47)
    test.equal_int(nfd.path_at_len(0), 10)
    test.equal_int(nfd.path_at_len(1), 10)
    -- second path starts with '/'
    test.equal_int(nfd.path_at_byte(1, 0), 47)
    -- 't' of "two"
    test.equal_int(nfd.path_at_byte(1, 3), 116)
end

@test
empty_set_is_cancel()
    test.assert(nfd.set_path_for_test("/tmp/z"), "prime")
    -- empty string fails set and leaves cancel state
    test.assert(not nfd.set_path_for_test(""), "empty fails")
    test.assert(not nfd.is_ok(), "not ok")
    test.equal_int(nfd.path_len(), 0)
end
