module app.jolt_boxes_fall

-- Headless: dynamic box falls under gravity; print when below threshold.

imports
    jolt.dynamics as jolt
    jolt.units as units
    ori.io as io
end

main()
    const g: int = units.gravity_earth_y_m()
    var sys: jolt.System = jolt.create_system(0, g, 0)
    -- floor (Wave 4 helper: top surface at y=0)
    const floor: jolt.Body = jolt.create_static_floor(sys, 0)
    -- box starts at y = 5m
    var box: jolt.Body = jolt.create_dynamic_box(sys, 0, 5000, 0, 500, 500, 500, 1000)
    const dt: int = units.step_60hz_micros()
    var i: int = 0
    var y: int = jolt.body_y_m(box)
    while i < 300
        jolt.step(sys, dt)
        y = jolt.body_y_m(box)
        i = i + 1
    end
    if y < 2000
        io.print("fell")
    else
        io.print("stuck")
    end
    jolt.destroy_body(box)
    jolt.destroy_body(floor)
    jolt.destroy_system(sys)
end
