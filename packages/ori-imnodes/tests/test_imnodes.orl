module test.imnodes

imports
    imnodes.editor as ed
    ori.test as test
end

@test
graph_counts()
    ed.graph_clear()
    test.assert(ed.graph_add_node(10), "n")
    test.assert(ed.graph_add_link(10, 20), "l")
    test.equal_int(ed.graph_node_count(), 1)
    test.equal_int(ed.graph_link_count(), 1)
end

@test
nodes_pins_links_query()
    -- product graph: two nodes, input+output pins, one named link
    ed.graph_clear()
    test.assert(ed.graph_add_node(1), "n1")
    test.assert(ed.graph_add_node(2), "n2")
    test.assert(ed.graph_add_pin(100, ed.PIN_OUTPUT), "out")
    test.assert(ed.graph_add_pin(200, ed.PIN_INPUT), "in")
    test.assert(ed.graph_add_link_id(7, 100, 200), "link")
    test.equal_int(ed.graph_node_count(), 2)
    test.equal_int(ed.graph_pin_count(), 2)
    test.equal_int(ed.graph_link_count(), 1)
    test.assert(ed.graph_has_node(1), "has1")
    test.assert(ed.graph_has_node(2), "has2")
    test.assert(not ed.graph_has_node(99), "no99")
    test.equal_int(ed.graph_pin_kind(0), ed.PIN_OUTPUT)
    test.equal_int(ed.graph_pin_kind(1), ed.PIN_INPUT)
    test.equal_int(ed.graph_pin_id(0), 100)
    test.equal_int(ed.graph_link_id(0), 7)
    test.equal_int(ed.graph_link_start(0), 100)
    test.equal_int(ed.graph_link_end(0), 200)
end

@test
clear_resets_all()
    ed.graph_clear()
    test.assert(ed.graph_add_node(5), "n")
    test.assert(ed.graph_add_pin(50, ed.PIN_INPUT), "p")
    test.assert(ed.graph_add_link(50, 51), "l")
    test.assert(ed.graph_node_count() > 0, "had nodes")
    ed.graph_clear()
    test.equal_int(ed.graph_node_count(), 0)
    test.equal_int(ed.graph_pin_count(), 0)
    test.equal_int(ed.graph_link_count(), 0)
    test.assert(not ed.graph_has_node(5), "cleared")
end

@test
editor_api_callable_headless()
    -- begin/end editor + node + pins + link must not crash headless (no-ops)
    ed.create_context()
    ed.begin_node_editor()
    ed.begin_node(1)
    ed.begin_output_attr(10)
    ed.end_attr()
    ed.begin_input_attr(20)
    ed.end_attr()
    ed.end_node()
    ed.link(1, 10, 20)
    ed.end_node_editor()
    ed.destroy_context()
    -- bookkeeping remains independent
    ed.graph_clear()
    test.assert(ed.graph_add_node(1), "book")
    test.equal_int(ed.graph_node_count(), 1)
end

@test
node_capacity_edge()
    -- fill to MAX_NODES (64); 65th fails
    ed.graph_clear()
    var i: int = 0
    while i < 64
        test.assert(ed.graph_add_node(i + 1), "fill")
        i = i + 1
    end
    test.equal_int(ed.graph_node_count(), 64)
    test.assert(not ed.graph_add_node(999), "overflow")
    test.equal_int(ed.graph_node_count(), 64)
    -- idempotent re-add of existing id still ok
    test.assert(ed.graph_add_node(1), "idempotent")
    test.equal_int(ed.graph_node_count(), 64)
end
