oridoc 1

namespace sqlite.db

doc module self
    summary:
        High-performance SQLite driver bindings with deterministic resource cleanup via Disposable.
    details:
        Provides structured database connections and prepared statements.
        Handles implement core.Disposable for deterministic cleanup via using blocks.
end

doc func open
    summary:
        Opens an SQLite database connection.
    param path:
        Filesystem path to the SQLite database file, or ":memory:" for an in-memory database.
    returns:
        A Db handle initialized with the opened connection.
end

doc func close
    summary:
        Explicitly closes an open database connection.
    param db:
        The database connection to close.
end

doc func is_open
    summary:
        Reports whether the database connection is currently open and valid.
    param db:
        The database connection to test.
    returns:
        True if the database handle is valid.
end

doc func exec
    summary:
        Executes a non-query SQL statement.
    param db:
        The database connection.
    param sql:
        The SQL query string to execute.
    returns:
        Zero on success, or an SQLite error code on failure.
end

doc func exec_ok
    summary:
        Executes a non-query SQL statement, returning a boolean status.
    param db:
        The database connection.
    param sql:
        The SQL query string to execute.
    returns:
        True if the query executed with return code zero.
end

doc func query_int
    summary:
        Executes a query and returns the integer value of the first column of the first row.
    param db:
        The database connection.
    param sql:
        The SELECT query string.
    returns:
        The integer result, or zero on failure.
end

doc func query_text
    summary:
        Executes a query and returns the text value of the first column of the first row.
    param db:
        The database connection.
    param sql:
        The SELECT query string.
    returns:
        The string result, or an empty string on failure.
end

doc func query_all_json
    summary:
        Executes a query and serializes all result rows to a JSON array string.
    param db:
        The database connection.
    param sql:
        The SELECT query string.
    returns:
        A JSON string containing the array of row objects.
end

doc func last_insert_rowid
    summary:
        Returns the rowid of the most recent successful INSERT on this connection.
    param db:
        The database connection.
    returns:
        The 64-bit integer rowid.
end

doc func changes
    summary:
        Returns the number of database rows changed or inserted by the most recent statement.
    param db:
        The database connection.
    returns:
        The number of affected rows.
end

doc func begin
    summary:
        Begins a database transaction.
    param db:
        The database connection.
    returns:
        True if the BEGIN statement succeeded.
end

doc func commit
    summary:
        Commits an active database transaction.
    param db:
        The database connection.
    returns:
        True if the COMMIT statement succeeded.
end

doc func rollback
    summary:
        Rolls back an active database transaction.
    param db:
        The database connection.
    returns:
        True if the ROLLBACK statement succeeded.
end

doc func prepare
    summary:
        Compiles an SQL string into a reusable prepared statement handle.
    param db:
        The database connection.
    param sql:
        The SQL statement to compile.
    returns:
        A compiled Stmt handle.
end

doc func bind_int
    summary:
        Binds an integer value to a 1-based parameter index in a prepared statement.
    param st:
        The prepared statement handle.
    param idx:
        The 1-based parameter index.
    param value:
        The integer value to bind.
    returns:
        Zero on success, or an SQLite error code.
end

doc func bind_text
    summary:
        Binds a string value to a 1-based parameter index in a prepared statement.
    param st:
        The prepared statement handle.
    param idx:
        The 1-based parameter index.
    param value:
        The string value to bind.
    returns:
        Zero on success, or an SQLite error code.
end

doc func step
    summary:
        Advances a prepared statement by one evaluation step.
    param st:
        The prepared statement handle.
    returns:
        STEP_ROW (100) if another row is ready, STEP_DONE (101) when complete, or an error code.
end

doc func column_int
    summary:
        Returns the integer value of a 0-based column index in the current row.
    param st:
        The prepared statement handle.
    param col:
        The 0-based column index.
    returns:
        The column integer value.
end

doc func column_text
    summary:
        Returns the string text value of a 0-based column index in the current row.
    param st:
        The prepared statement handle.
    param col:
        The 0-based column index.
    returns:
        The column string value.
end

doc func finalize
    summary:
        Destroys a prepared statement handle, freeing its internal resources.
    param st:
        The statement handle to finalize.
end
