module test.harfbuzz

imports
    freetype.face = ft
    harfbuzz.shape = hb
    ori.test = test
    ori.os = os
    ori.list = lists
end

font_path() -> string
    return os.env_or("ORI_FT_SMOKE_FONT", "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf")
end

@test
shape_hi_ltr()
    test.assert(ft.init(), "init")
    const face: ft.FaceId = ft.new_face(font_path())
    test.assert(ft.is_valid_face(face), "face")
    test.assert(ft.set_pixel_sizes(face, 0, 28), "size")
    const g: list[hb.ShapedGlyph] = hb.shape_dir(face, "Hi", hb.DIR_LTR)
    test.assert(hb.glyph_count(g) >= 2, "glyph count")
    test.assert(hb.total_x_advance_m(g) > 0, "advance")
    test.assert(g[0].glyph_id > 0, "glyph id")
    ft.done_face(face)
    ft.done()
end

@test
cursor_positions_hello()
    test.assert(ft.init(), "init")
    const face: ft.FaceId = ft.new_face(font_path())
    test.assert(ft.set_pixel_sizes(face, 0, 20), "size")
    const g: list[hb.ShapedGlyph] = hb.shape(face, "Hello")
    const n: int = hb.glyph_count(g)
    test.assert(n >= 5, "hello glyphs")
    const c: list[int] = hb.x_cursor_positions_m(g)
    test.equal_int(lists.len(c), n + 1)
    test.equal_int(c[0], 0)
    test.equal_int(c[n], hb.total_x_advance_m(g))
    ft.done_face(face)
    ft.done()
end

@test
shape_rtl_direction()
    test.assert(ft.init(), "init")
    const face: ft.FaceId = ft.new_face(font_path())
    test.assert(ft.set_pixel_sizes(face, 0, 24), "size")
    const g: list[hb.ShapedGlyph] = hb.shape_dir(face, "AB", hb.DIR_RTL)
    test.assert(hb.glyph_count(g) >= 2, "rtl glyphs")
    test.assert(hb.total_x_advance_m(g) > 0, "rtl advance")
    ft.done_face(face)
    ft.done()
end
