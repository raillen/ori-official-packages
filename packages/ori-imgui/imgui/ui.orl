-- Multi-context (editor vs game). Slot 0 is primary after init/init_raylib.
-- create_context allocates an extra isolated ImGui context (returns slot id or -1).
-- set_current_context switches which context subsequent widgets target.
-- destroy_context frees an extra slot (never destroys primary slot 0).
public create_context() -> int
    return ori_imgui_create_context()
end

public set_current_context(id: int) -> bool
    return ori_imgui_set_current_context(id) == 0
end

public current_context() -> int
    return ori_imgui_current_context()
end

public destroy_context(id: int) -> void
    ori_imgui_destroy_context(id)
end

public context_is_live(id: int) -> bool
    return ori_imgui_context_is_live(id) != 0
end

public max_contexts() -> int
    return ori_imgui_max_contexts()
end

