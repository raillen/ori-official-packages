-- Table flags (ImGuiTableFlags subset).
public const TABLE_RESIZABLE: int = 1
public const TABLE_ROW_BG: int = 64
-- Borders = InnerH|OuterH|InnerV|OuterV = 128+256+512+1024
public const TABLE_BORDERS: int = 1920

public init(width: int, height: int, title: string) -> bool
    return ori_imgui_init(width, height, mem.string_as_ptr(title)) == 0
end

-- Attach ImGui to the current raylib / game.app window (no second window).
public init_raylib() -> bool
    return ori_imgui_init_raylib() == 0
end

public shutdown() -> void
    ori_imgui_shutdown()
end

public should_close() -> bool
    return ori_imgui_should_close() != 0
end

public begin_frame() -> void
    ori_imgui_begin_frame()
end

public end_frame() -> void
    ori_imgui_end_frame()
end

-- Call inside game on_draw(), after world draw, before EndDrawing.
public begin_frame_raylib() -> void
    ori_imgui_begin_frame_raylib()
end

public end_frame_raylib() -> void
    ori_imgui_end_frame_raylib()
end

public is_raylib_mode() -> bool
    return ori_imgui_is_raylib_mode() != 0
end

public begin_window(name: string) -> bool
    return ori_imgui_begin(mem.string_as_ptr(name), 0) != 0
end

public end_window() -> void
    ori_imgui_end()
end

public button(label: string) -> bool
    return ori_imgui_button(mem.string_as_ptr(label)) != 0
end

public small_button(label: string) -> bool
    return ori_imgui_small_button(mem.string_as_ptr(label)) != 0
end

public text(label: string) -> void
    ori_imgui_text(mem.string_as_ptr(label))
end

public text_colored(r: int, g: int, b: int, a: int, label: string) -> void
    ori_imgui_text_colored(r, g, b, a, mem.string_as_ptr(label))
end

public checkbox(label: string, checked: bool) -> bool
    var c: int = 0
    if checked
        c = 1
    end
    return ori_imgui_checkbox(mem.string_as_ptr(label), c) != 0
end

public slider_int(label: string, value: int, v_min: int, v_max: int) -> int
    return ori_imgui_slider_int(mem.string_as_ptr(label), value, v_min, v_max)
end

-- Float slider via milli-int (value * 1000). Avoids float at FFI boundary.
public slider_float_milli(label: string, value_milli: int, v_min_milli: int, v_max_milli: int) -> int
    return ori_imgui_slider_float_milli(mem.string_as_ptr(label), value_milli, v_min_milli, v_max_milli)
end

public drag_int(label: string, value: int, v_min: int, v_max: int) -> int
    return ori_imgui_drag_int(mem.string_as_ptr(label), value, v_min, v_max)
end

public progress_bar(fraction_milli: int, overlay: string) -> void
    ori_imgui_progress_bar(fraction_milli, mem.string_as_ptr(overlay))
end

public collapsing_header(label: string) -> bool
    return ori_imgui_collapsing_header(mem.string_as_ptr(label)) != 0
end

public tree_node(label: string) -> bool
    return ori_imgui_tree_node(mem.string_as_ptr(label)) != 0
end

public tree_pop() -> void
    ori_imgui_tree_pop()
end

public separator() -> void
    ori_imgui_separator()
end

public same_line() -> void
    ori_imgui_same_line()
end

public spacing() -> void
    ori_imgui_spacing()
end

public bullet_text(label: string) -> void
    ori_imgui_bullet_text(mem.string_as_ptr(label))
end

public want_capture_mouse() -> bool
    return ori_imgui_want_capture_mouse() != 0
end

public want_capture_keyboard() -> bool
    return ori_imgui_want_capture_keyboard() != 0
end

-- True when cursor is over empty central dock (3D free; not Hierarchy/Inspector).
public is_viewport_hovered() -> bool
    return ori_imgui_is_viewport_hovered() != 0
end

public set_next_window_size(w: int, h: int) -> void
    ori_imgui_set_next_window_size(w, h)
end

public set_next_window_pos(x: int, y: int) -> void
    ori_imgui_set_next_window_pos(x, y)
end

-- Select active input-text slot (0..3) for input_text / input_text_set / input_text_value.
public input_text_select(slot: int) -> void
    ori_imgui_input_text_select(slot)
end

public input_text(label: string) -> bool
    return ori_imgui_input_text(mem.string_as_ptr(label)) != 0
end

public input_text_slot(label: string, slot: int) -> bool
    return ori_imgui_input_text_slot(mem.string_as_ptr(label), slot) != 0
end

public input_text_multiline(label: string, slot: int, height: int) -> bool
    return ori_imgui_input_text_multiline(mem.string_as_ptr(label), slot, height) != 0
end

public input_text_value() -> string
    const path: string = "/tmp/ori_imgui_input_text.tmp"
    if ori_imgui_input_text_to_path(mem.string_as_ptr(path)) != 0
        return ""
    end
    return fs.read_text_or(path, "")
end

public input_text_slot_value(slot: int) -> string
    const path: string = "/tmp/ori_imgui_input_text_slot.tmp"
    if ori_imgui_input_text_slot_to_path(slot, mem.string_as_ptr(path)) != 0
        return ""
    end
    return fs.read_text_or(path, "")
end

public input_text_set(value: string) -> void
    ori_imgui_input_text_set(mem.string_as_ptr(value))
end

public input_text_slot_set(slot: int, value: string) -> void
    ori_imgui_input_text_slot_set(slot, mem.string_as_ptr(value))
end

public input_text_clear(slot: int) -> void
    ori_imgui_input_text_clear(slot)
end

public input_text_len(slot: int) -> int
    return ori_imgui_input_text_len(slot)
end

-- Combo with up to 8 fixed labels (pass empty string for unused slots).
public combo(label: string, current: int, count: int, a0: string, a1: string, a2: string, a3: string, a4: string, a5: string, a6: string, a7: string) -> int
    return ori_imgui_combo(
        mem.string_as_ptr(label), current, count,
        mem.string_as_ptr(a0), mem.string_as_ptr(a1), mem.string_as_ptr(a2), mem.string_as_ptr(a3),
        mem.string_as_ptr(a4), mem.string_as_ptr(a5), mem.string_as_ptr(a6), mem.string_as_ptr(a7)
    )
end

public begin_child(id: string, w: int, h: int, border: bool) -> bool
    var b: int = 0
    if border
        b = 1
    end
    return ori_imgui_begin_child(mem.string_as_ptr(id), w, h, b) != 0
end

public end_child() -> void
    ori_imgui_end_child()
end

public begin_main_menu_bar() -> bool
    return ori_imgui_begin_main_menu_bar() != 0
end

public end_main_menu_bar() -> void
    ori_imgui_end_main_menu_bar()
end

public begin_menu(label: string) -> bool
    return ori_imgui_begin_menu(mem.string_as_ptr(label)) != 0
end

public end_menu() -> void
    ori_imgui_end_menu()
end

public menu_item(label: string) -> bool
    return ori_imgui_menu_item(mem.string_as_ptr(label)) != 0
end

