-- Draw a GPU texture by opaque id (OpenGL GLuint / raylib Texture.id as int).
public image(tex_id: int, w: int, h: int) -> void
    ori_imgui_image(tex_id, w, h)
end

-- Clickable image button; id must be unique among siblings. Returns true if clicked.
public image_button(id: string, tex_id: int, w: int, h: int) -> bool
    return ori_imgui_image_button(mem.string_as_ptr(id), tex_id, w, h) != 0
end

