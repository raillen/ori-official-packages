module game.marching_cubes

-- Marching Cubes (classic tables) — pure Ori, milli-int coords.
-- density: list[int] size nx*ny*nz; isolevel e.g. 500; cell_size_m edge size.

import ori.list = lists
import ori.fs = fs

public struct Vec3m
    x_m: int
    y_m: int
    z_m: int
end

public struct Tri
    a: Vec3m
    b: Vec3m
    c: Vec3m
end

public struct Mesh
    tris: list[Tri]
end

public empty_mesh() -> Mesh
    return Mesh { tris: [] }
end

public tri_count(m: Mesh) -> int
    return lists.len(m.tris)
end

public grid_index(nx: int, ny: int, x: int, y: int, z: int) -> int
    return x + y * nx + z * nx * ny
end

public sample(density: list[int], nx: int, ny: int, nz: int, x: int, y: int, z: int) -> int
    if x < 0 or y < 0 or z < 0
        return 0
    end
    if x >= nx or y >= ny or z >= nz
        return 0
    end
    const i: int = grid_index(nx, ny, x, y, z)
    const n: int = lists.len(density)
    if i < 0 or i >= n
        return 0
    end
    return density[i]
end

lerp_m(a_m: int, b_m: int, va: int, vb: int, iso: int) -> int
    const d: int = vb - va
    if d == 0
        return a_m
    end
    const t: int = ((iso - va) * 1000) / d
    return a_m + ((b_m - a_m) * t) / 1000
end

corner_offset(i: int) -> Vec3m
    if i == 0
        return Vec3m { x_m: 0, y_m: 0, z_m: 0 }
    elif i == 1
        return Vec3m { x_m: 1, y_m: 0, z_m: 0 }
    elif i == 2
        return Vec3m { x_m: 1, y_m: 1, z_m: 0 }
    elif i == 3
        return Vec3m { x_m: 0, y_m: 1, z_m: 0 }
    elif i == 4
        return Vec3m { x_m: 0, y_m: 0, z_m: 1 }
    elif i == 5
        return Vec3m { x_m: 1, y_m: 0, z_m: 1 }
    elif i == 6
        return Vec3m { x_m: 1, y_m: 1, z_m: 1 }
    end
    return Vec3m { x_m: 0, y_m: 1, z_m: 1 }
end

edge_corners(e: int) -> int
    if e == 0
        return 0 + (1 * 16)
    elif e == 1
        return 1 + (2 * 16)
    elif e == 2
        return 2 + (3 * 16)
    elif e == 3
        return 3 + (0 * 16)
    elif e == 4
        return 4 + (5 * 16)
    elif e == 5
        return 5 + (6 * 16)
    elif e == 6
        return 6 + (7 * 16)
    elif e == 7
        return 7 + (4 * 16)
    elif e == 8
        return 0 + (4 * 16)
    elif e == 9
        return 1 + (5 * 16)
    elif e == 10
        return 2 + (6 * 16)
    end
    return 3 + (7 * 16)
end

