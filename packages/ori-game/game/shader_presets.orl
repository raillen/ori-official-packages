module game.shader_presets

-- Documented material/fog helpers on top of game.shader (no shadow pipeline).

import game.shader = shader
import ori.math.vec3 = vec3

public struct FogParams
    density: float
    color_r: float
    color_g: float
    color_b: float
end

public default_fog() -> FogParams
    return FogParams { density: 0.02, color_r: 0.6, color_g: 0.7, color_b: 0.8 }
end

public apply_fog(sh: shader.ShaderId, fog: FogParams) -> void
    const loc_d: shader.LocationId = shader.location(sh, "fogDensity")
    const loc_c: shader.LocationId = shader.location(sh, "fogColor")
    if loc_d >= 0
        shader.set_float(sh, loc_d, fog.density)
    end
    if loc_c >= 0
        shader.set_vec3(sh, loc_c, vec3.Vec3 { x: fog.color_r, y: fog.color_g, z: fog.color_b })
    end
end

public struct MaterialMVP
    metallic: float
    roughness: float
end

public default_material() -> MaterialMVP
    return MaterialMVP { metallic: 0.0, roughness: 0.5 }
end

public apply_material(sh: shader.ShaderId, m: MaterialMVP) -> void
    const loc_m: shader.LocationId = shader.location(sh, "metallic")
    const loc_r: shader.LocationId = shader.location(sh, "roughness")
    if loc_m >= 0
        shader.set_float(sh, loc_m, m.metallic)
    end
    if loc_r >= 0
        shader.set_float(sh, loc_r, m.roughness)
    end
end
