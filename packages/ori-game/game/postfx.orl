module game.postfx

-- X2: toggable post/look presets (fog material params; host applies when shader loaded).

import game.shader_presets = presets
import game.shader = shader

public struct PostFxState
    fog_on: bool
    fog: presets.FogParams
    material: presets.MaterialMVP
    dither_on: bool
end

public create() -> PostFxState
    return PostFxState {
        fog_on: false,
        fog: presets.default_fog(),
        material: presets.default_material(),
        dither_on: false
    }
end

public toggle_fog(s: PostFxState) -> PostFxState
    var out: PostFxState = s
    out.fog_on = not out.fog_on
    return out
end

public toggle_dither(s: PostFxState) -> PostFxState
    var out: PostFxState = s
    out.dither_on = not out.dither_on
    return out
end

public set_fog_density(s: PostFxState, density: float) -> PostFxState
    var out: PostFxState = s
    out.fog.density = density
    return out
end

-- Apply active presets to a loaded PBR/lit shader (no-op if locs missing).
public apply_to_shader(s: PostFxState, sh: shader.ShaderId) -> void
    if sh <= 0
        return
    end
    if s.fog_on
        presets.apply_fog(sh, s.fog)
    end
    presets.apply_material(sh, s.material)
    if s.dither_on
        const loc: shader.LocationId = shader.location(sh, "ditherStrength")
        if loc >= 0
            shader.set_float(sh, loc, 0.04)
        end
    end
end

public status_line(s: PostFxState) -> string
    var line: string = "postfx"
    if s.fog_on
        line = line + " fog"
    end
    if s.dither_on
        line = line + " dither"
    end
    if s.fog_on == false and s.dither_on == false
        line = line + " off"
    end
    return line
end
