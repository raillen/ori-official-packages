module game.entity_collision

import game.engine = engine
import game.shape = shape
import game.collision = collision

public entity_rect(e: engine.Entity, half: float) -> shape.Rectangle
    return shape.Rectangle {
        x: e.pos.x - half,
        y: e.pos.y - half,
        width: half * 2.0,
        height: half * 2.0
    }
end

public entities_overlap(a: engine.Entity, b: engine.Entity, half: float) -> bool
    return collision.rects_overlap(entity_rect(a, half), entity_rect(b, half))
end
