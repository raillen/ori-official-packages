module app.shapes3d_demo

-- P2-B: cylinder / capsule / wires in a simple 3D scene.

imports
    game.app = app
    game.draw = draw
    game.draw3d = draw3d
    game.camera3d = cam3
    game.color = color
    game.input = input
    ori.math.vec2 = vec2
    ori.math.vec3 = vec3
end

var cam: cam3.Camera3D = cam3.create_perspective(
    vec3.Vec3 { x: 6.0, y: 4.0, z: 8.0 },
    vec3.Vec3 { x: 0.0, y: 1.0, z: 0.0 },
    45.0
)
var yaw: float = 0.0

on_update(dt: float) -> void
    if input.key_down(input.KEY_LEFT)
        yaw = yaw - 40.0 * dt
    end
    if input.key_down(input.KEY_RIGHT)
        yaw = yaw + 40.0 * dt
    end
    -- orbit camera on XZ
    const dist: float = 10.0
    const rad: float = yaw * 0.0174532925
    const cx: float = dist * 0.6
    -- simple circle using small-angle free: update target only
    cam = cam3.set_position(cam, vec3.Vec3 {
        x: 8.0 * (1.0 - yaw * 0.01),
        y: 4.0,
        z: 8.0 + yaw * 0.05
    })
end

on_draw() -> void
    cam3.begin_mode(cam)
    draw3d.draw_grid(20, 1.0)
    draw3d.draw_plane(vec3.Vec3 { x: 0.0, y: 0.0, z: 0.0 }, 12.0, 12.0, color.DARKGRAY)
    draw3d.draw_cylinder(
        vec3.Vec3 { x: -2.0, y: 1.0, z: 0.0 },
        0.2, 0.6, 2.0, 16, color.ORANGE
    )
    draw3d.draw_cylinder_wires(
        vec3.Vec3 { x: -2.0, y: 1.0, z: 0.0 },
        0.2, 0.6, 2.0, 16, color.WHITE
    )
    draw3d.draw_capsule(
        vec3.Vec3 { x: 2.0, y: 0.5, z: 0.0 },
        vec3.Vec3 { x: 2.0, y: 2.5, z: 0.0 },
        0.35, 12, 8, color.BLUE
    )
    draw3d.draw_sphere(vec3.Vec3 { x: 0.0, y: 1.2, z: 2.0 }, 0.5, color.GREEN)
    cam3.end_mode()
    draw.draw_text("shapes3d — cylinder/capsule (arrows nudge cam)", vec2.Vec2 { x: 10.0, y: 10.0 }, 16, color.WHITE)
end

main()
    app.run_window("Shapes 3D", 800, 480, on_update, on_draw)
end
