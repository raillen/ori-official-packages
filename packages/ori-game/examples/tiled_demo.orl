module app.tiled_demo

-- Load assets/maps/sample.tmj (Tiled JSON) and walk the solid tiles.

imports
    game.app as app
    game.draw as draw
    game.color as color
    game.input as input
    game.shape as shape
    game.tilemap as tilemap
    game.tiled as tiled
    ori.math.vec2 as vec2
    ori.math as math
    ori.list as lists
end

var grid: tilemap.Tilemap = tilemap.create(8, 5, 32.0)
var ready: bool = false
var status: string = "loading..."
var px: float = 48.0
var py: float = 64.0
const size: float = 14.0
const speed: float = 140.0

solid_at(wx: float, wy: float) -> bool
    var g: tilemap.Tilemap = grid
    if g.tile_size <= 0.0
        return false
    end
    const tx: int = math.floor(wx / g.tile_size)
    const ty: int = math.floor(wy / g.tile_size)
    return tiled.is_solid_gid(tilemap.get_tile(grid, tx, ty))
end

on_update(dt: float) -> void
    if not ready
        return
    end
    var nx: float = px
    var ny: float = py
    if input.key_down(input.KEY_RIGHT)
        nx = nx + speed * dt
    end
    if input.key_down(input.KEY_LEFT)
        nx = nx - speed * dt
    end
    if input.key_down(input.KEY_DOWN)
        ny = ny + speed * dt
    end
    if input.key_down(input.KEY_UP)
        ny = ny - speed * dt
    end
    if not solid_at(nx, ny) and not solid_at(nx + size, ny + size)
        px = nx
        py = ny
    end
end

on_draw() -> void
    if not ready
        draw.draw_text(status, vec2.Vec2 { x: 10.0, y: 10.0 }, 18, color.RED)
        return
    end
    var g: tilemap.Tilemap = grid
    var y: int = 0
    while y < g.height
        var x: int = 0
        while x < g.width
            const gid: int = tilemap.get_tile(grid, x, y)
            if tiled.is_solid_gid(gid)
                draw.draw_rect(tilemap.tile_rect(grid, x, y), color.DARKGREEN)
            else
                draw.draw_rect(tilemap.tile_rect(grid, x, y), color.DARKGRAY)
            end
            x = x + 1
        end
        y = y + 1
    end
    draw.draw_rect(shape.rect(px, py, size, size), color.YELLOW)
    draw.draw_text("Tiled JSON demo — arrows move", vec2.Vec2 { x: 10.0, y: 10.0 }, 16, color.WHITE)
    draw.draw_text(status, vec2.Vec2 { x: 10.0, y: 32.0 }, 14, color.LIGHTGRAY)
end

main()
    match tiled.load_map("assets/maps/sample.tmj")
        case ok(m):
            match tiled.first_layer_to_tilemap(m)
                case some(tm):
                    grid = tm
                    ready = true
                    status = "loaded sample.tmj"
                    match tiled.first_object_group(m)
                        case some(og):
                            const spawns: list[tiled.TiledObject] = tiled.objects_of_type(og, "spawn")
                            if lists.len(spawns) > 0
                                var s: tiled.TiledObject = spawns[0]
                                px = s.x
                                py = s.y
                            end
                        case none:
                    end
                case none:
                    status = "no tile layer"
            end
        case err(msg):
            status = msg
    end
    app.run_window("Tiled Demo", 320, 200, on_update, on_draw)
end
