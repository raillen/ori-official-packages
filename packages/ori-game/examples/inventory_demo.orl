module app.inventory_demo

imports
    game.app as app
    game.draw as draw
    game.color as color
    game.input as input
    game.inventory as inv
    ori.math.vec2 as vec2
end

var bag: inv.Inventory = inv.create(8)
var status: string = "Press 1-3 to add items"
var show: bool = true

on_update(dt: float) -> void
    if input.key_pressed(73)
        show = not show
    end
    if input.key_pressed(49)
        bag = inv.add(bag, inv.Item { id: "potion", name: "Potion", stackable: true, max_stack: 10 }, 1)
        status = "Added potion"
    end
    if input.key_pressed(50)
        bag = inv.add(bag, inv.Item { id: "sword", name: "Sword", stackable: false, max_stack: 1 }, 1)
        status = "Added sword"
    end
    if input.key_pressed(51)
        bag = inv.add(bag, inv.Item { id: "coin", name: "Coin", stackable: true, max_stack: 99 }, 5)
        status = "Added 5 coins"
    end
end

on_draw() -> void
    draw.draw_text("Inventory demo", vec2.Vec2 { x: 10.0, y: 10.0 }, 22, color.WHITE)
    draw.draw_text(status, vec2.Vec2 { x: 10.0, y: 40.0 }, 16, color.LIGHTGRAY)
    draw.draw_text("1=potion 2=sword 3=coins I=toggle", vec2.Vec2 { x: 10.0, y: 64.0 }, 16, color.GRAY)
    if show
        var b: inv.Inventory = bag
        var y: float = 100.0
        var i: int = 0
        while i < b.max_slots
            const s: inv.InventorySlot = b.slots[i]
            if s.empty
                draw.draw_text("- empty -", vec2.Vec2 { x: 20.0, y: y }, 16, color.DARKGRAY)
            else
                draw.draw_text(s.item.name, vec2.Vec2 { x: 20.0, y: y }, 16, color.YELLOW)
            end
            y = y + 22.0
            i = i + 1
        end
    end
end

main()
    app.run_window("Inventory Demo", 640, 360, on_update, on_draw)
end
