module app.skeletal_anim_demo

-- Loads optional model + animations; stub returns fake handles.

imports
    game.app as app
    game.draw as draw
    game.draw3d as draw3d
    game.camera3d as cam3
    game.color as color
    ori.math.vec2 as vec2
    ori.math.vec3 as vec3
end

var cam: cam3.Camera3D = cam3.create_perspective(
    vec3.Vec3 { x: 3.0, y: 2.0, z: 4.0 },
    vec3.Vec3 { x: 0.0, y: 0.5, z: 0.0 },
    45.0
)

var model: draw3d.ModelId = 0
var anims: draw3d.AnimSetId = 0
var frame: int = 0
var has_anim: bool = false

on_update(_dt: float) -> void
    if has_anim
        frame = draw3d.next_animation_frame(anims, 0, frame, 30)
        draw3d.update_model_animation(model, anims, 0, frame)
    end
end

on_draw() -> void
    cam3.begin_mode(cam)
    draw3d.draw_grid(8, 1.0)
    if model != 0
        draw3d.draw_model(model, vec3.Vec3 { x: 0.0, y: 0.0, z: 0.0 }, 1.0, color.WHITE)
    else
        draw3d.draw_cube(vec3.Vec3 { x: 0.0, y: 0.5, z: 0.0 }, 0.6, 1.0, 0.4, color.GREEN)
    end
    cam3.end_mode()
    draw.draw_text("skeletal_anim_demo", vec2.Vec2 { x: 10.0, y: 10.0 }, 18, color.WHITE)
end

main()
    model = draw3d.load_model("assets/cube.obj")
    anims = draw3d.load_model_animations("assets/cube.obj")
    if anims != 0 and draw3d.model_animation_count(anims) > 0
        has_anim = true
    end
    app.run_window("Skeletal Anim", 800, 450, on_update, on_draw)
    if has_anim
        draw3d.unload_model_animations(anims)
    end
    if model != 0
        draw3d.unload_model(model)
    end
end
