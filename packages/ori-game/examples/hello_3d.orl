module app.hello_3d

imports
    game.app = app
    game.draw = draw
    game.draw3d = draw3d
    game.camera3d = cam3
    game.color = color
    game.input = input
    ori.math.vec2 = vec2
    ori.math.vec3 = vec3
end

var cam: cam3.Camera3D = cam3.create_perspective(
    vec3.Vec3 { x: 4.0, y: 3.0, z: 4.0 },
    vec3.Vec3 { x: 0.0, y: 0.5, z: 0.0 },
    45.0
)

-- Optional .obj (assets/cube.obj); stub returns a fake handle if missing.
var model: draw3d.ModelId = 0
var model_loaded: bool = false

on_update(dt: float) -> void
    if input.key_down(input.KEY_LEFT)
        const pos: vec3.Vec3 = cam3.position_of(cam)
        cam = cam3.set_position(cam, vec3.Vec3 {
            x: pos.x - 2.0 * dt,
            y: pos.y,
            z: pos.z
        })
    end
    if input.key_down(input.KEY_RIGHT)
        const pos: vec3.Vec3 = cam3.position_of(cam)
        cam = cam3.set_position(cam, vec3.Vec3 {
            x: pos.x + 2.0 * dt,
            y: pos.y,
            z: pos.z
        })
    end
end

on_draw() -> void
    cam3.begin_mode(cam)
    draw3d.draw_grid(10, 1.0)
    draw3d.draw_cube(
        vec3.Vec3 { x: 0.0, y: 0.5, z: 0.0 },
        1.0, 1.0, 1.0,
        color.RED
    )
    draw3d.draw_cube_wires(
        vec3.Vec3 { x: 0.0, y: 0.5, z: 0.0 },
        1.0, 1.0, 1.0,
        color.WHITE
    )
    draw3d.draw_sphere(
        vec3.Vec3 { x: 2.0, y: 0.5, z: 0.0 },
        0.4,
        color.BLUE
    )
    if model_loaded
        draw3d.draw_model(
            model,
            vec3.Vec3 { x: -2.0, y: 0.5, z: 0.0 },
            1.0,
            color.GREEN
        )
    end
    cam3.end_mode()
    draw.draw_text(
        "hello_3d — arrows move camera",
        vec2.Vec2 { x: 10.0, y: 10.0 },
        18,
        color.WHITE
    )
end

main()
    model = draw3d.load_model("assets/cube.obj")
    if model != 0
        model_loaded = true
    end
    app.run_window("Hello Ori 3D", 800, 450, on_update, on_draw)
    if model_loaded
        draw3d.unload_model(model)
    end
end
