module app.shader_light_demo

-- Load shaders after the window/GL context exists (first frame).

imports
    game.app as app
    game.draw as draw
    game.draw3d as draw3d
    game.camera3d as cam3
    game.color as color
    game.shader as shader
    game.light as light
    ori.math.vec2 as vec2
    ori.math.vec3 as vec3
end

var cam: cam3.Camera3D = cam3.create_perspective(
    vec3.Vec3 { x: 4.0, y: 3.0, z: 5.0 },
    vec3.Vec3 { x: 0.0, y: 0.5, z: 0.0 },
    45.0
)

var sh: shader.ShaderId = 0
var loaded: bool = false
var loc_enabled: shader.LocationId = 0 - 1
var loc_kind: shader.LocationId = 0 - 1
var loc_pos: shader.LocationId = 0 - 1
var loc_target: shader.LocationId = 0 - 1
var loc_color: shader.LocationId = 0 - 1
var loc_intensity: shader.LocationId = 0 - 1
var sun: light.Light = light.create_directional(
    vec3.Vec3 { x: -0.4, y: -1.0, z: -0.3 },
    color.WHITE,
    1.2
)

ensure_shader() -> void
    if loaded
        return
    end
    loaded = true
    sh = shader.load("assets/shaders/lighting.vs", "assets/shaders/lighting.fs")
    if sh != 0
        loc_enabled = shader.location(sh, "lightEnabled")
        loc_kind = shader.location(sh, "lightType")
        loc_pos = shader.location(sh, "lightPos")
        loc_target = shader.location(sh, "lightTarget")
        loc_color = shader.location(sh, "lightColor")
        loc_intensity = shader.location(sh, "lightIntensity")
    end
end

on_update(_dt: float) -> void
    ensure_shader()
end

on_draw() -> void
    ensure_shader()
    if sh != 0
        light.upload(sh, sun, loc_enabled, loc_kind, loc_pos, loc_target, loc_color, loc_intensity)
        shader.begin_mode(sh)
    end
    cam3.begin_mode(cam)
    draw3d.draw_grid(10, 1.0)
    draw3d.draw_cube(vec3.Vec3 { x: 0.0, y: 0.5, z: 0.0 }, 1.0, 1.0, 1.0, color.RED)
    draw3d.draw_sphere(vec3.Vec3 { x: 2.0, y: 0.5, z: 0.0 }, 0.5, color.BLUE)
    cam3.end_mode()
    if sh != 0
        shader.end_mode()
    end
    draw.draw_text("shader_light_demo", vec2.Vec2 { x: 10.0, y: 10.0 }, 18, color.WHITE)
end

main()
    app.run_window("Shader Light", 800, 450, on_update, on_draw)
    if sh != 0
        shader.unload(sh)
    end
end
