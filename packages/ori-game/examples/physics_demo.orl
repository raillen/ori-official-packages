module app.physics_demo

imports
    game.app = app
    game.draw = draw
    game.color = color
    game.input = input
    game.physics = physics
    game.shape = shape
    ori.math.vec2 = vec2
end

var world: physics.PhysicsWorld = physics.create_world(600.0)
const floor_y: float = 320.0

on_update(dt: float) -> void
    if input.key_pressed(input.KEY_SPACE)
        world = physics.add_body(world, input.mouse_pos(), 1.0, 12.0)
    end
    world = physics.step(world, dt)
    const n: int = physics.body_count(world)
    var i: int = 0
    while i < n
        var w: physics.PhysicsWorld = world
        var b: physics.PhysicsBody = w.bodies[i]
        if b.alive and b.pos.y + b.radius > floor_y
            b.pos = vec2.Vec2 { x: b.pos.x, y: floor_y - b.radius }
            b.vel = vec2.Vec2 { x: b.vel.x * 0.8, y: -b.vel.y * 0.4 }
            world = physics.set_body(world, i, b)
        end
        i = i + 1
    end
end

on_draw() -> void
    draw.draw_rect(shape.rect(0.0, floor_y, 640.0, 40.0), color.DARKGRAY)
    const n: int = physics.body_count(world)
    var i: int = 0
    while i < n
        var w: physics.PhysicsWorld = world
        const b: physics.PhysicsBody = w.bodies[i]
        if b.alive
            draw.draw_circle(b.pos, b.radius, color.BLUE)
        end
        i = i + 1
    end
    draw.draw_text("Space: spawn ball at mouse", vec2.Vec2 { x: 10.0, y: 10.0 }, 18, color.WHITE)
end

main()
    world = physics.add_body(world, vec2.Vec2 { x: 200.0, y: 40.0 }, 1.0, 14.0)
    world = physics.add_body(world, vec2.Vec2 { x: 320.0, y: 20.0 }, 1.0, 10.0)
    app.run_window("Physics Demo", 640, 360, on_update, on_draw)
end
