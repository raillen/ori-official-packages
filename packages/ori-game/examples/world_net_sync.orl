module app.world_net_sync

-- R7.2+ wire: enet host/client troca payload game.world_replicate (ws:).
-- Event loop no estilo enet/examples/game_tf_sync (service único por lado).

imports
    enet.session = net
    enet.host = enet
    game.world = world
    game.world_replicate = wr
    ori.io = io
end

const PORT: int = 27791
const MAX_ITERS: int = 800

spawn_pair() -> world.World
    var w: world.World = world.empty_world()
    var t0: world.Transform = world.empty_transform()
    t0.x = 1.5
    t0.y = 2.0
    t0.z = -3.25
    w = world.spawn_entity(
        w,
        world.EntityMeta {
            instance_id: "a",
            entity_type: "player",
            primary_tag: "player"
        },
        t0
    )
    var t1: world.Transform = world.empty_transform()
    t1.x = 10.0
    t1.y = 0.0
    t1.z = 4.0
    w = world.spawn_entity(
        w,
        world.EntityMeta {
            instance_id: "b",
            entity_type: "enemy",
            primary_tag: "enemy"
        },
        t1
    )
    return w
end

main()
    var host: net.NetSession = net.start_host(PORT)
    if host.ready == false
        io.print("fail")
        return
    end
    var client: net.NetSession = net.start_client("127.0.0.1", PORT)
    if client.ready == false
        io.print("fail")
        host = net.shutdown(host)
        net.deinit_global()
        return
    end

    var host_world: world.World = spawn_pair()
    var client_world: world.World = spawn_pair()
    const cid0: world.EntityId = world.get_entity(client_world, 0).id
    var bad: world.Transform = world.empty_transform()
    bad.x = 99.0
    bad.y = 99.0
    bad.z = 99.0
    client_world = world.set_transform(client_world, cid0, bad)

    var server_connected: bool = false
    var client_connected: bool = false
    var sent: bool = false
    var applied: bool = false

    var i: int = 0
    while i < MAX_ITERS
        const se: int = enet.service(host.host, 5)
        if se == enet.EVENT_CONNECT
            server_connected = true
            host.connected = true
            host.peer = enet.event_peer()
        end

        const ce: int = enet.service(client.host, 5)
        if ce == enet.EVENT_CONNECT
            client_connected = true
            client.connected = true
        end
        if ce == enet.EVENT_RECEIVE
            const msg: string = enet.packet_text()
            enet.destroy_packet()
            if wr.is_ws_message(msg)
                client_world = wr.apply_message(client_world, msg)
                applied = true
            end
        end

        if server_connected and client_connected and sent == false
            const payload: string = wr.encode_world(host_world, 7)
            if enet.peer_is_valid(host.peer)
                const rc: int = enet.send_text(host.peer, payload, 0, true)
                enet.flush(host.host)
                if rc == 0
                    sent = true
                end
            end
        end

        if sent and applied
            break
        end
        i = i + 1
    end

    var ok: bool = false
    if applied
        match world.find_by_id(client_world, cid0)
            case some(e):
                if e.transform.x > 1.4 and e.transform.x < 1.6
                    ok = true
                end
            case none:
        end
    end

    if ok
        io.print("ok")
    else
        io.print("fail")
    end

    client = net.shutdown(client)
    host = net.shutdown(host)
    net.deinit_global()
end
