module test.marching_cubes

imports
    game.marching_cubes = mc
    ori.test = test
    ori.list = lists
end

@test
empty_grid_zero_tris()
    const d: list[int] = mc.fill_box(2, 2, 2, 0, 0, 0, 0, 0, 0, 1000, 0)
    const m: mc.Mesh = mc.isosurface(d, 2, 2, 2, 500, 1000)
    test.equal_int(mc.tri_count(m), 0)
    test.assert(not mc.has_surface(m), "no surface empty")
end

@test
solid_box_has_surface()
    -- 6x6x6 with solid cube in center → outer surface triangles
    const d: list[int] = mc.fill_box(6, 6, 6, 2, 2, 2, 4, 4, 4, 1000, 0)
    const m: mc.Mesh = mc.isosurface(d, 6, 6, 6, 500, 1000)
    test.assert(mc.tri_count(m) > 0, "expected triangles on solid box")
    test.assert(mc.has_surface(m), "has_surface")
    test.assert(lists.len(d) == 6 * 6 * 6, "density size")
end

@test
fill_box_density_count()
    const d: list[int] = mc.fill_box(4, 4, 4, 1, 1, 1, 3, 3, 3, 1000, 0)
    test.equal_int(lists.len(d), 64)
    var solid_n: int = 0
    var i: int = 0
    while i < lists.len(d)
        if d[i] == 1000
            solid_n = solid_n + 1
        end
        i = i + 1
    end
    -- 2x2x2 solid region
    test.equal_int(solid_n, 8)
end

@test
mesh_bounds_and_flatten()
    const d: list[int] = mc.fill_box(5, 5, 5, 1, 1, 1, 3, 3, 3, 1000, 0)
    const m: mc.Mesh = mc.isosurface(d, 5, 5, 5, 500, 1000)
    test.assert(mc.tri_count(m) > 0, "tris")
    test.equal_int(mc.vertex_count(m), mc.tri_count(m) * 3)
    const flat: list[int] = mc.flatten_positions_m(m)
    test.equal_int(lists.len(flat), mc.vertex_count(m) * 3)
    const idx: list[int] = mc.flatten_indices(m)
    test.equal_int(lists.len(idx), mc.tri_count(m) * 3)
    const wires: list[int] = mc.flatten_wire_segments_m(m)
    test.equal_int(lists.len(wires), mc.wire_segment_count(m) * 6)
    const b: mc.Bounds3m = mc.mesh_bounds(m)
    test.assert(b.max_x_m >= b.min_x_m, "bounds x")
    test.assert(b.max_y_m >= b.min_y_m, "bounds y")
    test.assert(b.max_z_m >= b.min_z_m, "bounds z")
end

@test
m_to_f_scale()
    test.assert(mc.m_to_f(1000) > 0.9, "1000m ≈ 1.0")
    test.assert(mc.m_to_f(0) == 0.0, "zero")
end
