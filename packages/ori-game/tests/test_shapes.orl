module test.shapes

imports
    ori.test = test
    game.color = color
    game.shape = shape
    game.collision = collision
end

@test
from_rgb_values()
    const c: color.Color = color.from_rgb(1, 2, 3)
    test.equal_int(c.r, 1)
    test.equal_int(c.g, 2)
    test.equal_int(c.b, 3)
end

@test
rects_overlap_true()
    const a: shape.Rectangle = shape.rect(0.0, 0.0, 10.0, 10.0)
    const b: shape.Rectangle = shape.rect(5.0, 5.0, 10.0, 10.0)
    test.assert(collision.rects_overlap(a, b), "overlap")
end

@test
rects_overlap_false()
    const a: shape.Rectangle = shape.rect(0.0, 0.0, 10.0, 10.0)
    const b: shape.Rectangle = shape.rect(20.0, 20.0, 10.0, 10.0)
    test.assert(not collision.rects_overlap(a, b), "no overlap")
end
