module config.routes

import web as web
import app.controllers.home as home
import app.controllers.posts as posts

public draw(a: web.App) -> void
    web.get(a, "/", home.index)
    web.get(a, "/posts", posts.index)
    web.get(a, "/posts/:id", posts.show)
    web.get(a, "/healthz", home.health)
end
