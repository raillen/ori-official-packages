module app.loopback_ping

-- In-process server + client: connect, reliable "ping"/"pong", tear down.

imports
    enet.host as enet
    ori.io as io
end

const port: int = 27777
const channels: int = 2
const max_iters: int = 400

main()
    if not enet.initialize_ok()
        io.print("init_fail")
        return
    end

    var server: enet.Host = enet.create_server(port, 8, channels)
    if not enet.is_valid(server)
        io.print("server_fail")
        enet.deinitialize()
        return
    end

    var client: enet.Host = enet.create_client(1, channels)
    if not enet.is_valid(client)
        io.print("client_fail")
        enet.destroy(server)
        enet.deinitialize()
        return
    end

    var remote: enet.Peer = enet.connect(client, "127.0.0.1", port, channels)
    if not enet.peer_is_valid(remote)
        io.print("connect_fail")
        enet.destroy(client)
        enet.destroy(server)
        enet.deinitialize()
        return
    end

    var server_connected: bool = false
    var client_connected: bool = false
    var got_ping: bool = false
    var got_pong: bool = false
    var server_peer: enet.Peer = enet.Peer { id: 0 - 1 }

    var i: int = 0
    while i < max_iters
        const se: int = enet.service(server, 5)
        if se == enet.EVENT_CONNECT
            server_connected = true
            server_peer = enet.event_peer()
        end
        if se == enet.EVENT_RECEIVE
            const msg: string = enet.packet_text()
            enet.destroy_packet()
            if msg == "ping"
                got_ping = true
                const send_rc: int = enet.send_text(server_peer, "pong", 0, true)
                if send_rc != 0
                    io.print("reply_fail")
                    enet.destroy(client)
                    enet.destroy(server)
                    enet.deinitialize()
                    return
                end
                enet.flush(server)
            end
        end

        const ce: int = enet.service(client, 5)
        if ce == enet.EVENT_CONNECT
            client_connected = true
            const send_rc: int = enet.send_text(remote, "ping", 0, true)
            if send_rc != 0
                io.print("send_fail")
                enet.destroy(client)
                enet.destroy(server)
                enet.deinitialize()
                return
            end
            enet.flush(client)
        end
        if ce == enet.EVENT_RECEIVE
            const msg: string = enet.packet_text()
            enet.destroy_packet()
            if msg == "pong"
                got_pong = true
            end
        end

        if server_connected and client_connected and got_ping and got_pong
            break
        end
        i = i + 1
    end

    enet.disconnect_now(remote)
    enet.destroy(client)
    enet.destroy(server)
    enet.deinitialize()

    if server_connected and client_connected and got_ping and got_pong
        io.print("ok")
        return
    end
    io.print("fail")
end
